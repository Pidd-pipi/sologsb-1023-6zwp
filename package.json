{
  "name": "sologsb-1023-multi-version-collation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:merge": "esbuild scripts/merge.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/merge.test.mjs && node node_modules/.cache/merge.test.mjs",
    "test:storage": "esbuild src/lib/storage.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/storage.cjs && STORAGE_LIB=./node_modules/.cache/storage.cjs node scripts/storage.test.cjs",
    "test": "npm run test:merge && npm run test:storage"
  },
  "dependencies": {
    "@arco-design/web-vue": "2.58.0",
    "vue": "3.5.26"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "5.8.3",
    "vite": "6.4.1",
    "vue-tsc": "2.2.12"
  }
}
